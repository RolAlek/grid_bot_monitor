# ==============================================================================
# Grid Bot Monitor — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in the required values.
# Never commit `.env` to version control.
# ==============================================================================

# ── Pionex API ────────────────────────────────────────────────────────────────
# REQUIRED: API key and secret from Pionex (https://www.pionex.com/en/apikey)
# The key must have permissions for: Futures Grid trading + Market Data.

PIONEX_API_KEY=your_api_key_here
PIONEX_API_SECRET=your_api_secret_here

# Optional — defaults shown:
# PIONEX_BASE_URL=https://api.pionex.com
# PIONEX_TIMEOUT=10
# PIONEX_KLINE_INTERVAL=4H          # 1H, 2H, 4H, 6H, 8H, 12H, 1D
# PIONEX_LIMIT=500                  # max candles per request


# ── PostgreSQL Database ───────────────────────────────────────────────────────
# REQUIRED: database password.

DB_PASSWORD=your_db_password_here

# Optional — defaults shown:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=grid_advisor
# DB_ECHO=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10


# ── Telegram Bot ──────────────────────────────────────────────────────────────
# REQUIRED: bot token (from @BotFather) and target chat ID.

TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890


# ── Application ───────────────────────────────────────────────────────────────
# APP_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR | FATAL
# APP_LOG_JSON=true                  # true = JSON lines, false = coloured console
# APP_LOG_DIR=logs                   # directory for daily log files
# APP_LOG_FILE_DAYS=3                # days to keep log files


# ── Decision Engine ───────────────────────────────────────────────────────────
#   Gates that control whether to LAUNCH / REVIEW / HOLD a grid bot.
# ------------------------------------------------------------------------------
# Gate 1 — Market Regime (ADX / ATR / volatility)
#
# DECISION_ENGINE_ADX_PASS_MAX=25.0           # ADX <= 25 → PASS
# DECISION_ENGINE_ADX_CAUTION_MAX=30.0         # ADX <= 30 → CAUTION
# DECISION_ENGINE_ATR_RANGE_MULTIPLIER_MIN=3.0  # grid_range >= 3×ATR → PASS
# DECISION_ENGINE_TARGET_CELL_ATR_FRACTION=0.3  # cell size ≈ 0.3×ATR

# Gate 2 — Positioning (funding rate + OI dynamics)
#
# DECISION_ENGINE_FUNDING_ANNUALIZED_CAUTION_PCT=20.0
# DECISION_ENGINE_FUNDING_ANNUALIZED_FAIL_PCT=40.0
# DECISION_ENGINE_OI_7D_CHANGE_CAUTION_PCT=10.0
# DECISION_ENGINE_OI_7D_CHANGE_FAIL_PCT=20.0
# DECISION_ENGINE_VOL_TERM_STRUCTURE_MIN_RATIO=1.05
# DECISION_ENGINE_TREND_BIAS_LONG_THRESHOLD=2
# DECISION_ENGINE_TREND_BIAS_SHORT_THRESHOLD=-2

# Gate 3 — Liquidation Safety
#
# DECISION_ENGINE_LIQ_BUFFER_MULTIPLIER_MIN=2.5
# DECISION_ENGINE_LEVERAGE_HARD_CAP=5

# Default grid parameters (when auto-drawing from swing range)
# DECISION_ENGINE_DEFAULT_LEVERAGE=1
# DECISION_ENGINE_DEFAULT_QUOTE_INVESTMENT=1000.0
# DECISION_ENGINE_MIN_GRID_ROWS=5
# DECISION_ENGINE_MAX_GRID_ROWS=120
# DECISION_ENGINE_TAKE_PROFIT_BUFFER_ATR=3.0


# ── Health Monitoring ─────────────────────────────────────────────────────────
#   Nested settings use `__` as delimiter (pydantic-settings convention).
# ------------------------------------------------------------------------------

# Intervals (minutes)
# MONITORING_INTERVALS__HEALTH_CHECK_MINUTES=30
# MONITORING_INTERVALS__AUTO_ADJUST_MINUTES=30
# MONITORING_INTERVALS__METRICS_TTL_DAYS=90
# MONITORING_INTERVALS__ALERT_DEBOUNCE_MINUTES=5

# Scoring weights (must sum to ~1.0)
# MONITORING_WEIGHTS__DISTANCE_TO_LIQ=0.35
# MONITORING_WEIGHTS__PNL=0.20
# MONITORING_WEIGHTS__FILL_RATIO=0.15
# MONITORING_WEIGHTS__VOLATILITY=0.15
# MONITORING_WEIGHTS__FUNDING=0.10
# MONITORING_WEIGHTS__ADX=0.05

# Thresholds (GREEN ⇄ YELLOW ⇄ RED)
# MONITORING_THRESHOLDS__LIQ_DISTANCE_GREEN_MIN_PCT=15.0
# MONITORING_THRESHOLDS__LIQ_DISTANCE_YELLOW_MIN_PCT=7.5
# MONITORING_THRESHOLDS__PNL_GREEN_MIN_PCT=-5.0
# MONITORING_THRESHOLDS__PNL_YELLOW_MIN_PCT=-15.0
# MONITORING_THRESHOLDS__FILL_GREEN_MAX=0.70
# MONITORING_THRESHOLDS__FILL_YELLOW_MAX=0.90
# MONITORING_THRESHOLDS__ATR_PCT_GREEN_MAX=5.0
# MONITORING_THRESHOLDS__ATR_PCT_YELLOW_MAX=10.0
# MONITORING_THRESHOLDS__FUNDING_GREEN_MAX_ABS_PCT=15.0
# MONITORING_THRESHOLDS__FUNDING_YELLOW_MAX_ABS_PCT=30.0
# MONITORING_THRESHOLDS__ADX_GREEN_MAX=25.0
# MONITORING_THRESHOLDS__ADX_YELLOW_MAX=35.0
# MONITORING_THRESHOLDS__RSI_OVERSOLD=30.0
# MONITORING_THRESHOLDS__RSI_OVERBOUGHT=70.0

# Automation
# MONITORING_AUTO_ADJUST_ENABLED=false
# MONITORING_AUTO_PAUSE_ON_RED=true
# MONITORING_AUTO_RESUME_ON_GREEN=false
# MONITORING_MAX_CONSECUTIVE_YELLOW_BEFORE_ACTION=4
